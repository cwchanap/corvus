{
  "name": "extension",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wxt -b chrome --port 5001",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts --passWithNoTests",
    "test:coverage": "vitest run --config vitest.config.ts --coverage --passWithNoTests",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/spline-sans-mono": "^5.3.0",
    "@repo/common": "workspace:*",
    "@repo/ui-components": "workspace:*",
    "solid-js": "1.9.7",
    "wxt": "^0.21.4"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.31.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.1",
    "typescript": "5.8.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^3.2.4"
  }
}
